---
import Base from "../layouts/Base.astro";
import AccountDrawer from "../components/AccountDrawer.astro";
import "../styles/global.css";
---

<Base title="Stampd | Inbox">
  <AccountDrawer />

  <div class="flex h-screen w-full overflow-hidden">
    <!-- SIDEBAR -->
    <aside class="flex flex-col h-screen w-[240px] p-6 bg-surface-container-lowest border-r border-outline-variant z-40 shrink-0">
      <div class="mb-10">
        <span class="text-headline-md font-bold text-primary tracking-tight">Stampd</span>
        <p class="text-label-md text-on-secondary-container mt-1">Secure Mail</p>
      </div>

      <nav class="flex-1 space-y-1" id="sidebar-nav">
        <a href="/" data-folder="inbox" class="sidebar-link flex items-center gap-3 px-4 py-2.5 rounded transition-all duration-200 bg-secondary-container text-on-secondary-container font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
          <span class="text-label-md flex-1">Inbox</span>
          <span class="font-mono text-mono-sm text-on-secondary-container" id="inbox-count">0</span>
        </a>
        <a href="/" data-folder="sent" class="sidebar-link flex items-center gap-3 px-4 py-2.5 rounded text-on-surface-variant hover:bg-surface-variant transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          <span class="text-label-md flex-1">Sent</span>
        </a>
        <a href="/" data-folder="drafts" class="sidebar-link flex items-center gap-3 px-4 py-2.5 rounded text-on-surface-variant hover:bg-surface-variant transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          <span class="text-label-md flex-1">Drafts</span>
        </a>
        <a href="/" data-folder="archive" class="sidebar-link flex items-center gap-3 px-4 py-2.5 rounded text-on-surface-variant hover:bg-surface-variant transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
          <span class="text-label-md flex-1">Archive</span>
        </a>
        <a href="/" data-folder="spam" class="sidebar-link flex items-center gap-3 px-4 py-2.5 rounded text-on-surface-variant hover:bg-surface-variant transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          <span class="text-label-md flex-1">Spam</span>
        </a>
      </nav>

      <div class="mt-auto space-y-4">
        <a href="/compose" class="compose-btn w-full flex items-center justify-center gap-2 bg-primary-container text-on-primary-container py-4 rounded-xl shadow-lg active:scale-95 transition-all font-bold hover:opacity-90">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <span class="text-label-md">Compose</span>
        </a>
        <div class="pt-4 border-t border-outline-variant space-y-1">
          <a href="/settings" class="flex items-center gap-3 px-4 py-2 text-on-surface-variant hover:bg-surface-variant rounded transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
            <span class="text-label-md">Settings</span>
          </a>
          <a href="/admin" id="admin-link" class="hidden flex items-center gap-3 px-4 py-2 text-on-surface-variant hover:bg-surface-variant rounded transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <span class="text-label-md">Admin</span>
          </a>
          <button id="logout-btn" class="w-full flex items-center gap-3 px-4 py-2 text-on-surface-variant hover:bg-surface-variant rounded transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            <span class="text-label-md">Log out</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- MESSAGE LIST -->
    <main class="flex flex-col h-screen w-[360px] bg-surface-container-low border-r border-outline-variant z-30 shrink-0" id="message-list-pane">
      <div class="h-16 flex items-center justify-between px-6 border-b border-outline-variant">
        <h1 class="text-headline-sm font-semibold text-on-surface" id="folder-title">Inbox</h1>
        <div class="flex gap-2">
          <button class="p-1.5 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors" id="refresh-btn" title="Refresh">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
          </button>
          <button class="p-1.5 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors" id="search-toggle" title="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </div>

      <!-- Search bar (hidden by default) -->
      <div class="hidden px-6 py-3 border-b border-outline-variant bg-surface-container-low" id="search-bar">
        <input
          id="search-input"
          type="text"
          placeholder="Search messages..."
          class="w-full bg-surface-container border border-outline-variant rounded-lg px-4 py-2.5 text-body-md text-on-surface placeholder:text-on-secondary-container/50 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors"
        />
      </div>

      <!-- Message list container -->
      <div class="flex-1 overflow-y-auto custom-scrollbar" id="message-list">
        <div class="flex items-center justify-center h-full text-on-secondary-container text-body-md" id="loading-state">
          Loading messages...
        </div>
      </div>
    </main>

    <!-- READING PANE -->
    <section class="flex-1 flex flex-col h-screen bg-surface min-w-0" id="reading-pane">
      <div class="flex-1 flex items-center justify-center text-on-secondary-container text-body-md" id="empty-state">
        Select a message to read
      </div>
    </section>
  </div>

  <script>
    import {
      listMessages,
      getMessage,
      deleteMessage,
      getMailboxStats,
      logout as apiLogout,
      archiveMessage,
      unarchiveMessage,
      reportSpam,
      notSpam,
      markRead,
      sendDraft,
    } from "../lib/api";
    import { getUser, setUser, requireAuth } from "../lib/auth";
    import type { MailboxMessage, MessageDetail } from "../lib/api";

    // ── Auth ──────────────────────────────────────────────
    const user = requireAuth();
    if (user.is_admin) document.getElementById("admin-link")?.classList.remove("hidden");

    // ── State ─────────────────────────────────────────────
    let messages: MailboxMessage[] = [];
    let selectedId: string | null = null;
    let selectedMsg: MessageDetail | null = null;
    let currentFolder = "inbox";
    let searchQuery = "";

    // ── DOM refs ──────────────────────────────────────────
    const messageList = document.getElementById("message-list")!;
    const readingPane = document.getElementById("reading-pane")!;
    const folderTitle = document.getElementById("folder-title")!;
    const inboxCount = document.getElementById("inbox-count")!;
    const searchBar = document.getElementById("search-bar")!;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const refreshBtn = document.getElementById("refresh-btn")!;
    const searchToggle = document.getElementById("search-toggle")!;

    // ── Sidebar active state ──────────────────────────────
    function setActiveFolder(folder: string) {
      currentFolder = folder;
      document.querySelectorAll(".sidebar-link").forEach((link) => {
        const el = link as HTMLElement;
        const f = el.dataset.folder;
        if (f === folder) {
          el.className = "sidebar-link flex items-center gap-3 px-4 py-2.5 rounded transition-all duration-200 bg-secondary-container text-on-secondary-container font-bold";
        } else {
          el.className = "sidebar-link flex items-center gap-3 px-4 py-2.5 rounded text-on-surface-variant hover:bg-surface-variant transition-colors duration-200";
        }
      });
      folderTitle.textContent = folder.charAt(0).toUpperCase() + folder.slice(1);
    }

    document.querySelectorAll(".sidebar-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const folder = (link as HTMLElement).dataset.folder!;
        setActiveFolder(folder);
        selectedId = null;
        selectedMsg = null;
        renderReadingPane();
        loadMessages();
      });
    });

    // ── Search ────────────────────────────────────────────
    searchToggle.addEventListener("click", () => {
      searchBar.classList.toggle("hidden");
      if (!searchBar.classList.contains("hidden")) {
        searchInput.focus();
      } else {
        searchQuery = "";
        searchInput.value = "";
        renderMessageList();
      }
    });

    searchInput.addEventListener("input", () => {
      searchQuery = searchInput.value.toLowerCase();
      renderMessageList();
    });

    // ── Keyboard nav ──────────────────────────────────────
    document.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).tagName === "INPUT" || (e.target as HTMLElement).tagName === "TEXTAREA") return;

      const filtered = getFilteredMessages();
      if (filtered.length === 0) return;

      const currentIndex = selectedId ? filtered.findIndex((m) => m.id === selectedId) : -1;

      if (e.key === "j" || e.key === "ArrowDown") {
        e.preventDefault();
        const next = currentIndex + 1;
        if (next < filtered.length) selectMessage(filtered[next].id);
      } else if (e.key === "k" || e.key === "ArrowUp") {
        e.preventDefault();
        const prev = currentIndex - 1;
        if (prev >= 0) selectMessage(filtered[prev].id);
      } else if (e.key === "Enter" || e.key === "o") {
        if (selectedId) openMessage(selectedId);
      } else if (e.key === "Escape") {
        if (selectedMsg) {
          selectedMsg = null;
          selectedId = null;
          renderReadingPane();
          renderMessageList();
        }
      } else if (e.key === "r") {
        if (selectedMsg) {
          let replyTo: string;
          if (currentFolder === "sent") {
            replyTo = selectedMsg.to;
          } else {
            replyTo = selectedMsg.from;
          }
          const params = new URLSearchParams({
            to: replyTo,
            subject: `Re: ${selectedMsg.subject || ""}`,
          });
          window.location.href = `/compose?${params.toString()}`;
        }
      } else if (e.key === "f") {
        if (selectedMsg) {
          const params = new URLSearchParams({
            subject: `Fwd: ${selectedMsg.subject || ""}`,
            body: `\n\n---------- Forwarded message ----------\nFrom: ${selectedMsg.from}\nTo: ${selectedMsg.to}\nSubject: ${selectedMsg.subject}\n\n${selectedMsg.body || ""}`,
          });
          window.location.href = `/compose?${params.toString()}`;
        }
      } else if (e.key === "#") {
        if (selectedId) deleteById(selectedId);
      }
    });

    // ── Filtering ─────────────────────────────────────────
    function getFilteredMessages(): MailboxMessage[] {
      if (!searchQuery) return messages;
      return messages.filter(
        (m) =>
          m.subject.toLowerCase().includes(searchQuery) ||
          m.from.toLowerCase().includes(searchQuery) ||
          m.to.toLowerCase().includes(searchQuery),
      );
    }

    // ── Load messages ─────────────────────────────────────
    async function loadMessages() {
      try {
        const { messages: msgs } = await listMessages(currentFolder as any);
        messages = msgs;
        inboxCount.textContent = String(msgs.length);
        renderMessageList();
      } catch {
        messageList.innerHTML = `
          <div class="flex flex-col items-center justify-center h-full gap-4 text-on-secondary-container">
            <p class="text-body-md">Failed to load messages</p>
            <p class="text-body-sm">Is the gateway running?</p>
            <button class="mt-2 px-4 py-2 bg-primary-container text-on-primary-container rounded-lg text-label-md font-bold hover:opacity-90" onclick="window.location.reload()">Retry</button>
          </div>`;
      }
    }

    // ── Render message list ───────────────────────────────
    function renderMessageList() {
      const filtered = getFilteredMessages();

      if (filtered.length === 0) {
        messageList.innerHTML = `
          <div class="flex items-center justify-center h-full text-on-secondary-container text-body-md">
            ${searchQuery ? "No matching messages" : "No messages"}
          </div>`;
        return;
      }

      const html = filtered.map((msg) => {
        const initials = msg.from.split("@")[0].slice(0, 2).toUpperCase();
        const isSelected = msg.id === selectedId;
        const subject = msg.subject || "(no subject)";
        const date = new Date(msg.date);
        const timeStr = date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

        let nameDisplay: string;
        if (currentFolder === "sent") {
          nameDisplay = `To: ${msg.to.split("@")[0]}`;
        } else if (currentFolder === "drafts") {
          nameDisplay = `To: ${msg.to || "(no recipient)"}`;
        } else {
          nameDisplay = msg.from.split("@")[0];
        }

        let actionButtons = "";
        if (currentFolder === "drafts") {
          actionButtons = `
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-primary edit-draft-btn" data-id="${msg.id}" title="Edit">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            </button>
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-primary send-draft-btn" data-id="${msg.id}" title="Send">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </button>`;
        } else if (currentFolder === "archive") {
          actionButtons = `
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-primary unarchive-btn" data-id="${msg.id}" title="Unarchive">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="m12 3 9 5H3z"/></svg>
            </button>`;
        } else if (currentFolder === "spam") {
          actionButtons = `
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-primary not-spam-btn" data-id="${msg.id}" title="Not Spam">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </button>`;
        } else {
          actionButtons = `
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-primary archive-btn" data-id="${msg.id}" title="Archive">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
            </button>
            <button class="p-1.5 hover:bg-surface-bright rounded transition-colors text-error delete-btn" data-id="${msg.id}" title="Delete">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            </button>`;
        }

        return `
          <div class="msg-item relative group p-6 border-b border-outline-variant cursor-pointer transition-colors ${isSelected ? "bg-surface-container hover:bg-surface-container-high" : "hover:bg-surface-container"}" data-id="${msg.id}" data-key="${msg.id}">
            <div class="flex gap-4 mb-2">
              <div class="w-10 h-10 rounded-full flex items-center justify-center bg-secondary-container text-on-secondary-container font-bold text-xs shrink-0">
                ${initials}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-start">
                  <p class="truncate ${isSelected ? "font-bold" : "font-semibold"} text-on-surface">${escapeHtml(nameDisplay)}</p>
                  <span class="font-mono text-[10px] text-on-secondary-container shrink-0 ml-2">${timeStr}</span>
                </div>
                <p class="text-body-md truncate ${isSelected ? "text-primary font-medium" : "text-on-surface-variant"}">Subject: ${escapeHtml(subject)}</p>
              </div>
            </div>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity bg-surface-container-highest p-1 rounded-lg">
              ${actionButtons}
            </div>
          </div>`;
      }).join("");

      messageList.innerHTML = html;

      messageList.querySelectorAll(".msg-item").forEach((el) => {
        el.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest(".delete-btn, .archive-btn, .unarchive-btn, .not-spam-btn, .edit-draft-btn, .send-draft-btn")) return;
          const id = (el as HTMLElement).dataset.id!;
          selectMessage(id);
        });
      });

      messageList.querySelectorAll(".delete-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          await deleteById(id);
        });
      });

      messageList.querySelectorAll(".archive-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          await archiveById(id);
        });
      });

      messageList.querySelectorAll(".unarchive-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          await unarchiveById(id);
        });
      });

      messageList.querySelectorAll(".not-spam-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          await notSpamById(id);
        });
      });

      messageList.querySelectorAll(".edit-draft-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          window.location.href = `/compose?draft=${id}`;
        });
      });

      messageList.querySelectorAll(".send-draft-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          try {
            await sendDraft(id);
            await loadMessages();
          } catch {}
        });
      });
    }

    // ── Select message (highlight in list) ────────────────
    function selectMessage(id: string) {
      selectedId = id;
      renderMessageList();
      openMessage(id);
    }

    // ── Open message in reading pane ──────────────────────
    async function openMessage(id: string) {
      renderReadingPane(null, true);

      try {
        const msg = await getMessage(id);
        selectedMsg = msg;
        if (currentFolder === "inbox" && msg.folder === "new") {
          try { await markRead(id); } catch {}
        }
        renderReadingPane(msg, false);
      } catch {
        readingPane.innerHTML = `
          <div class="flex-1 flex items-center justify-center text-error text-body-md">Failed to load message</div>`;
      }
    }

    // ── Render reading pane ───────────────────────────────
    function renderReadingPane(msg?: MessageDetail | null, loading = false) {
      if (loading) {
        readingPane.innerHTML = `
          <div class="flex-1 flex items-center justify-center text-on-secondary-container text-body-md">
            <svg class="animate-spin mr-3" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            Loading...
          </div>`;
        return;
      }

      if (!msg) {
        readingPane.innerHTML = `
          <div class="flex-1 flex flex-col items-center justify-center text-on-secondary-container gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-30"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <p class="text-body-md">Select a message to read</p>
            <p class="text-body-sm opacity-60">Use j/k to navigate, Enter to open, r to reply</p>
          </div>`;
        return;
      }

      const date = new Date(msg.date);
      const dateStr = date.toLocaleString();
      const subject = msg.subject || "(no subject)";
      const bodyHtml = (msg.body || "").replace(/\n/g, "<br>");
      const initials = msg.from.split("@")[0].slice(0, 2).toUpperCase();
      const isDraft = currentFolder === "drafts";

      let headerButtons = "";
      if (!isDraft) {
        headerButtons = `
          <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors" id="pane-archive" title="Archive">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
          </button>
          <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors" id="pane-spam" title="Report Spam">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          </button>
          <button class="p-2 hover:bg-surface-container rounded-full text-error transition-colors" id="pane-delete" title="Delete (#)">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>`;
      }

      let actionButtons = "";
      if (isDraft) {
        actionButtons = `
          <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary" id="pane-edit-draft">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            Edit
          </button>
          <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary" id="pane-send-draft">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            Send
          </button>`;
      } else {
        actionButtons = `
          <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary" id="pane-reply">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3"/><path d="m3 15 4 4 4-4"/><path d="M7 8v8l4-4-4-4z"/></svg>
            Reply
          </button>
          <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary" id="pane-forward">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3"/><path d="m14 4 4 4-4 4"/><path d="M17 8V4l4 4-4 4"/></svg>
            Forward
          </button>`;
      }

      readingPane.innerHTML = `
        <header class="h-16 flex items-center justify-between px-6 border-b border-outline-variant bg-surface-container-lowest shrink-0">
          <div class="flex items-center gap-4">
            <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors" id="pane-back" title="Back to list (Esc)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            ${headerButtons}
          </div>
          <div class="flex items-center gap-4">
            <button class="p-0.5 rounded-full border-2 border-primary hover:opacity-80 transition-opacity" onclick="document.getElementById('account-drawer')?.classList.toggle('translate-x-full')">
              <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center text-xs font-bold">
                ${user.email.charAt(0).toUpperCase()}
              </div>
            </button>
          </div>
        </header>
        <div class="flex-1 overflow-y-auto custom-scrollbar p-6 bg-surface">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-display-sm font-semibold mb-8 text-on-surface tracking-tight">${escapeHtml(subject)}</h2>
            <div class="flex items-center justify-between mb-10">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-primary text-on-primary font-bold text-lg">
                  ${initials}
                </div>
                <div>
                  <p class="font-bold text-on-surface">
                    ${isDraft ? escapeHtml(msg.to || "(no recipient)") : escapeHtml(msg.from.split("@")[0])}
                    <span class="font-normal text-on-secondary-container ml-2">&lt;${isDraft ? escapeHtml(msg.to || "") : escapeHtml(msg.from)}&gt;</span>
                  </p>
                  <p class="text-body-sm text-on-secondary-container">${isDraft ? "Draft" : `to ${escapeHtml(msg.to)}`}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="font-mono text-mono-sm text-on-secondary-container">${dateStr}</p>
              </div>
            </div>
            <div class="space-y-6 text-on-surface-variant leading-relaxed text-body-lg">${bodyHtml}</div>
          </div>
        </div>
        <footer class="p-6 border-t border-outline-variant bg-surface-container-lowest shrink-0">
          <div class="max-w-3xl mx-auto flex gap-4">
            ${actionButtons}
          </div>
        </footer>`;

      document.getElementById("pane-back")?.addEventListener("click", () => {
        selectedMsg = null;
        selectedId = null;
        renderReadingPane();
        renderMessageList();
      });

      document.getElementById("pane-delete")?.addEventListener("click", () => {
        if (selectedId) deleteById(selectedId);
      });

      document.getElementById("pane-archive")?.addEventListener("click", () => {
        if (selectedId) archiveById(selectedId);
      });

      document.getElementById("pane-spam")?.addEventListener("click", () => {
        if (selectedId) reportSpamById(selectedId);
      });

      document.getElementById("pane-reply")?.addEventListener("click", () => {
        if (!msg) return;
        let replyTo: string;
        if (currentFolder === "sent") {
          replyTo = msg.to;
        } else {
          replyTo = msg.from;
        }
        const params = new URLSearchParams({
          to: replyTo,
          subject: `Re: ${msg.subject || ""}`,
        });
        window.location.href = `/compose?${params.toString()}`;
      });

      document.getElementById("pane-forward")?.addEventListener("click", () => {
        if (!msg) return;
        const params = new URLSearchParams({
          subject: `Fwd: ${msg.subject || ""}`,
          body: `\n\n---------- Forwarded message ----------\nFrom: ${msg.from}\nTo: ${msg.to}\nSubject: ${msg.subject}\n\n${msg.body || ""}`,
        });
        window.location.href = `/compose?${params.toString()}`;
      });

      document.getElementById("pane-edit-draft")?.addEventListener("click", () => {
        if (!msg) return;
        window.location.href = `/compose?draft=${msg.id}`;
      });

      document.getElementById("pane-send-draft")?.addEventListener("click", async () => {
        if (!msg) return;
        try {
          await sendDraft(msg.id);
          await loadMessages();
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        } catch {}
      });
    }

    // ── Delete message ────────────────────────────────────
    async function deleteById(id: string) {
      try {
        await deleteMessage(id);
        messages = messages.filter((m) => m.id !== id);
        inboxCount.textContent = String(messages.length);

        if (selectedId === id) {
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        }
        renderMessageList();
      } catch {}
    }

    // ── Archive message ───────────────────────────────────
    async function archiveById(id: string) {
      try {
        await archiveMessage(id);
        messages = messages.filter((m) => m.id !== id);
        inboxCount.textContent = String(messages.length);

        if (selectedId === id) {
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        }
        renderMessageList();
      } catch {}
    }

    // ── Unarchive message ─────────────────────────────────
    async function unarchiveById(id: string) {
      try {
        await unarchiveMessage(id);
        messages = messages.filter((m) => m.id !== id);
        inboxCount.textContent = String(messages.length);

        if (selectedId === id) {
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        }
        renderMessageList();
      } catch {}
    }

    // ── Report spam ───────────────────────────────────────
    async function reportSpamById(id: string) {
      try {
        await reportSpam(id);
        messages = messages.filter((m) => m.id !== id);
        inboxCount.textContent = String(messages.length);

        if (selectedId === id) {
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        }
        renderMessageList();
      } catch {}
    }

    // ── Not spam ──────────────────────────────────────────
    async function notSpamById(id: string) {
      try {
        await notSpam(id);
        messages = messages.filter((m) => m.id !== id);
        inboxCount.textContent = String(messages.length);

        if (selectedId === id) {
          selectedId = null;
          selectedMsg = null;
          renderReadingPane();
        }
        renderMessageList();
      } catch {}
    }

    // ── Refresh ───────────────────────────────────────────
    refreshBtn.addEventListener("click", loadMessages);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) loadMessages();
    });

    // ── Escape HTML ───────────────────────────────────────
    function escapeHtml(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    // ── Logout ────────────────────────────────────────────
    document.getElementById("logout-btn")?.addEventListener("click", async () => {
      try { await apiLogout(); } catch {}
      setUser(null);
      window.location.href = "/login";
    });

    // ── Init ──────────────────────────────────────────────
    loadMessages();
  </script>
</Base>
