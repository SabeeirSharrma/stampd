---
import Base from "../layouts/Base.astro";
import ComposeForm from "../components/react/ComposeForm";
import "../styles/global.css";
---

<Base title="Stampd | Compose">
  <ComposeForm
    client:load
    draftId={Astro.url.searchParams.get("draft")}
    presetTo={Astro.url.searchParams.get("to") || undefined}
    presetSubject={Astro.url.searchParams.get("subject") || undefined}
    presetBody={Astro.url.searchParams.get("body") || undefined}
  />
</Base>
