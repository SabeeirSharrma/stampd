const icon = icons[name];
---

{icon ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox={icon.viewBox}
    fill={fill ? "currentColor" : "none"}
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    {icon.paths.map((d) => (
      <path d={d} />
    ))}
  </svg>
) : (
  <span class={`inline-block ${className}`}>?</span>
)}
