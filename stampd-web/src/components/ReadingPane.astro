---
import Icon from "./Icon.astro";
---

<section class="flex-1 flex flex-col h-screen bg-surface">
  <!-- Reading Pane Header -->
  <header class="h-16 flex items-center justify-between px-6 border-b border-outline-variant bg-surface-container-lowest">
    <div class="flex items-center gap-4">
      <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors">
        <Icon name="archive" size={20} />
      </button>
      <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors">
        <Icon name="shield-alert" size={20} />
      </button>
      <button class="p-2 hover:bg-surface-container rounded-full text-error transition-colors">
        <Icon name="trash" size={20} />
      </button>
      <div class="w-px h-6 bg-outline-variant mx-2"></div>
      <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors">
        <Icon name="tag" size={20} />
      </button>
    </div>
    <div class="flex items-center gap-4">
      <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors">
        <Icon name="chevron-left" size={20} />
      </button>
      <button class="p-2 hover:bg-surface-container rounded-full text-on-surface-variant transition-colors">
        <Icon name="chevron-right" size={20} />
      </button>
      <!-- User avatar -->
      <button
        id="account-toggle"
        class="p-0.5 rounded-full border-2 border-primary hover:opacity-80 transition-opacity"
      >
        <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center text-xs font-bold">
          AT
        </div>
      </button>
    </div>
  </header>

  <!-- Email Content Area -->
  <div class="flex-1 overflow-y-auto custom-scrollbar p-6 bg-surface">
    <div class="max-w-3xl mx-auto">
      <!-- Subject -->
      <h2 class="text-display-sm font-semibold mb-8 text-on-surface tracking-tight">
        Quarterly Security Protocol Update
      </h2>

      <!-- Sender Info -->
      <div class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full flex items-center justify-center bg-primary text-on-primary font-bold text-lg">
            JD
          </div>
          <div>
            <p class="font-bold text-on-surface">
              Julian Draxler
              <span class="font-normal text-on-secondary-container ml-2">&lt;j.draxler@stampd.io&gt;</span>
            </p>
            <p class="text-body-sm text-on-secondary-container">to me</p>
          </div>
        </div>
        <div class="text-right">
          <p class="font-mono text-mono-sm text-on-secondary-container">Oct 14, 2023, 14:02 (2 hours ago)</p>
          <button class="text-primary font-bold text-body-sm mt-1 hover:underline">
            View Security Signature
          </button>
        </div>
      </div>

      <!-- Body -->
      <div class="space-y-6 text-on-surface-variant leading-relaxed text-body-lg">
        <p>Hi Alex,</p>
        <p>
          I've completed the preliminary review of our quarterly security audit. Overall, the
          infrastructure remains highly resilient, but there are a few areas where we need to
          tighten our rotation policies for the primary salt keys.
        </p>
        <p>I've highlighted the following critical points:</p>
        <ul class="list-disc pl-6 space-y-3">
          <li class="text-on-surface">Update the master decryption key every 45 days instead of 90.</li>
          <li class="text-on-surface">Enforce hardware-level 2FA for all administrator accounts by EOD Friday.</li>
          <li class="text-on-surface">Review the logs for the Singapore cluster; there was a minor latency spike that needs investigating.</li>
        </ul>
        <p>
          Please review the attached PDF for the full breakdown of the audit. We should sync
          tomorrow morning to discuss the implementation timeline for these changes.
        </p>
        <p>Best regards,<br />Julian</p>
      </div>

      <!-- Attachment -->
      <div class="mt-12 p-4 border border-outline-variant rounded-xl flex items-center gap-4 hover:bg-surface-container-low transition-colors cursor-pointer group bg-surface-container-lowest">
        <div class="w-12 h-12 bg-surface-container rounded flex items-center justify-center text-primary">
          <Icon name="file-text" size={24} />
        </div>
        <div class="flex-1">
          <p class="font-bold text-body-md text-on-surface">security_audit_q3_final.pdf</p>
          <p class="text-body-sm text-on-secondary-container">4.2 MB</p>
        </div>
        <button class="opacity-0 group-hover:opacity-100 transition-opacity text-on-surface-variant hover:text-primary">
          <Icon name="download" size={20} />
        </button>
      </div>
    </div>
  </div>

  <!-- Reply Actions Footer -->
  <footer class="p-6 border-t border-outline-variant bg-surface-container-lowest">
    <div class="max-w-3xl mx-auto flex gap-4">
      <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary">
        <Icon name="reply" size={20} />
        Reply
      </button>
      <button class="flex-1 flex items-center justify-center gap-2 border border-outline-variant py-3 rounded-lg hover:bg-surface-container transition-colors font-bold text-primary">
        <Icon name="forward" size={20} />
        Forward
      </button>
    </div>
  </footer>
</section>
