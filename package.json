{
  "name": "stampd",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "stampd-gateway",
    "stampd-web"
  ],
  "scripts": {
    "dev:engine": "cargo run -p stampd-engine",
    "dev:cli": "cargo run -p stampd-cli -- up",
    "dev:gateway": "bun run --filter stampd-gateway dev",
    "dev:admin": "cd stampd-admin && uvicorn app.main:app --reload --port 8081",
    "dev": "cargo run -p stampd-cli -- up",
    "build": "cargo build --release",
    "test": "cargo test",
    "lint": "cargo clippy --all-targets --all-features"
  },
  "dependencies": {
    "@sabeeirsharrma/transit": "^2.4.0",
    "transit-cli": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
